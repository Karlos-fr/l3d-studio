# Fireworks - Gerbes colorees compactes avec positions Q4.4.
PARTICLE_CONFIG 32, -1, 246, 20
SET_U8 R0, 4
SET_U8 R1, 1
SET_U8 R2, 4

loop:
FADE 190
RAND_U8 R3, 0, 255
RAND_U8 R4, 12, 28
RAND_U8 R5, 0, 255
RAND_U8 R6, 0, 255
COLOR_WHEEL R6
PARTICLE_EMIT R0, R1, R2, R3, R4, R5
PARTICLE_STEP
SHOW
WAIT 50
JUMP loop
